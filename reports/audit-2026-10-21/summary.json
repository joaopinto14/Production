      "id": "A03",
      "severity": "medium",
      "type": "confirmed availability failure",
      "title": "Shutdown loses active requests and has no bounded wait"
    },
    {
      "id": "A04",
      "severity": "medium",
      "type": "confirmed release assurance gap",
      "title": "Stable publication rebuilds artefacts without binding maintenance scans to promoted digests"
    },
    {
      "id": "A05",
      "severity": "medium",
      "type": "confirmed workflow ordering/recovery gap",
      "title": "Release can fail after alias promotion and cannot safely resume through the current preflight"
    },
    {
      "id": "A06",
      "severity": "medium",
      "type": "CI hardening gap",
      "title": "Mutable Actions references and broad release-job permissions"
    },
    {
      "id": "A07",
      "severity": "medium",
      "type": "confirmed context exposure possibility; no actual secret exposure established",
      "title": "Credential-provider paths and .env are not excluded from build context"
    },
    {
      "id": "A08",
      "severity": "medium",
      "type": "confirmed deployment/availability failures",
      "title": "Read-only example fails and tmpfs capacity can be smaller than allowed requests"
    },
    {
      "id": "A09",
      "severity": "medium",
      "type": "confirmed false-positive test success",
      "title": "Image-size budget passes when docker save fails"
    },
    {
      "id": "A10",
      "severity": "medium",
      "type": "documented operational limitation; confirmed experimentally",
      "title": "Health endpoint stays successful while PHP requests fail"
    },
    {
      "id": "A11",
      "severity": "low",
      "type": "confirmed scan-policy completeness gap",
      "title": "A partial OS package report can pass the candidate policy"
