server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name _;

    root __DOCUMENT_ROOT__;
    index index.php;
    charset utf-8;

    client_max_body_size __UPLOAD_MAX_SIZE__;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }

    location = /robots.txt {
        access_log off;
        log_not_found off;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ ^/index\.php(/|$) {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_hide_header X-Powered-By;

        fastcgi_pass unix:/run/production/php/php-fpm.sock;
        fastcgi_read_timeout 300s;
    }

    # Laravel is a front-controller application. No other PHP file under
    # public/ should be directly executable through Nginx.
    location ~ \.php$ {
        return 404;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
