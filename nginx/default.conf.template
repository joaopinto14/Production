server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name _;

    root __DOCUMENT_ROOT__;
    index index.php index.html;

    client_max_body_size __UPLOAD_MAX_SIZE__;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # FPM's built-in ping needs no application file or application dependencies.
    location = /readyz {
        access_log off;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /readyz;
        fastcgi_pass unix:/run/production/php/php-fpm.sock;
        fastcgi_connect_timeout 1s;
        fastcgi_read_timeout 2s;
        fastcgi_hide_header X-Powered-By;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }

    location = /robots.txt {
        access_log off;
        log_not_found off;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Regex locations are evaluated in order: protect hidden paths before PHP.
    location ~ /\.(?!well-known(?:/|$)) {
        deny all;
    }

    location ~ \.php$ {
        try_files $uri =404;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_hide_header X-Powered-By;

        fastcgi_pass unix:/run/production/php/php-fpm.sock;
        fastcgi_read_timeout 300s;
    }

    # PHP-like names and backup suffixes must never fall through to static files.
    location ~* \.(?:php|phtml|phar|phps)(?:[^a-z0-9]|$) {
        return 404;
    }

}
